# Copie para .env.production e mantenha esse arquivo fora do Git.
COMPOSE_PROJECT_NAME=pedidos-gitex
APP_IMAGE=pedidos-gitex:local
APP_BIND_PORT=8080
NODE_VERSION=24.13.0
PNPM_VERSION=10.26.1

# O usuário bootstrap administra o cluster, mas nunca é usado pelo serviço web.
POSTGRES_DB=pedidos_gitex
POSTGRES_USER=pedidos_gitex_cluster_admin
POSTGRES_PASSWORD=SUBSTITUA_POR_SENHA_ADMIN_FORTE

# Runtime e migrations usam papéis distintos e senhas fortes.
APP_DB_USER=pedidos_gitex_app
APP_DB_PASSWORD=SUBSTITUA_POR_SENHA_APP_FORTE
MIGRATION_DB_USER=pedidos_gitex_migrator
MIGRATION_DB_PASSWORD=SUBSTITUA_POR_SENHA_MIGRATION_FORTE

# Codifique caracteres reservados das senhas nestas URLs.
DATABASE_URL=postgresql://pedidos_gitex_app:SUBSTITUA_POR_SENHA_APP_URL_ENCODED@postgres:5432/pedidos_gitex
MIGRATION_DATABASE_URL=postgresql://pedidos_gitex_migrator:SUBSTITUA_POR_SENHA_MIGRATION_URL_ENCODED@postgres:5432/pedidos_gitex

NODE_ENV=production
BETTER_AUTH_URL=https://pedidos.gitex.com.br
SESSION_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_DE_32_OU_MAIS_CARACTERES
ERP_API_KEY=SUBSTITUA_POR_UMA_CHAVE_ERP_ALEATORIA_E_EXCLUSIVA
# Limite exclusivo de chamadas ERP autenticadas (padrão: 5.000 por minuto).
ERP_RATE_LIMIT_MAX=5000
ERP_RATE_LIMIT_WINDOW_MS=60000
LOG_LEVEL=info

# Ajuste apenas após medir e considerar max_connections do PostgreSQL.
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=10000
DB_SSL_MODE=disable